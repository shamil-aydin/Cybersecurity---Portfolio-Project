# Copy to .env.local (git-ignored). Address of the Wazuh Manager API as seen from the machine running `npm run dev`.
WAZUH_URL=https://10.0.2.8:55000

# Wazuh Indexer (OpenSearch, port 9200) — where alerts/logs actually live. The dev
# proxy injects this Basic Auth on every /indexer-api request, so the browser
# bundle never sees these credentials.
WAZUH_INDEXER_URL=https://10.0.2.8:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=admin
